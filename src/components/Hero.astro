---
// Hero section - Linear/Vercel inspired with animated background
import AnimatedBackground from './AnimatedBackground.tsx';
import AnimatedLogo from './AnimatedLogo.tsx';
import AnimatedOrb from './AnimatedOrb.tsx';
---

<section class="hero" aria-labelledby="hero-heading">
  <!-- Canvas particle background -->
  <AnimatedBackground client:visible />

  <!-- Morphing gradient orb -->
  <div class="hero-orb-wrapper" aria-hidden="true">
    <AnimatedOrb client:visible />
  </div>

  <!-- Gradient orbs -->
  <div class="hero-orb hero-orb--accent" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--cyan" aria-hidden="true"></div>
  
  <div class="hero-content">
    <div class="stagger-children">
      <!-- Animated logo -->
      <div class="hero-logo-wrapper">
        <AnimatedLogo client:visible />
      </div>

      <h1 id="hero-heading" class="hero-title heading-glow">
        Toma el control de<br />
        <span class="gradient-text">tu dinero</span>
      </h1>
      
      <p class="hero-subtitle">
        El gestor de finanzas personales que te da claridad total sin complicaciones.
      </p>
      
      <div class="hero-actions">
        <a href="https://wallet-wise.devcodewolf.com" class="btn-primary btn-hero" rel="noopener">
          Empezar ahora
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a href="#features" class="btn-ghost">
          Ver características
        </a>
      </div>

      <!-- Trust bar — Linear-style minimal tech row -->
      <div class="trust-bar">
        <span class="trust-label">Construido con</span>
        <div class="trust-logos">
          <span class="trust-logo">React</span>
          <span class="trust-dot" aria-hidden="true">·</span>
          <span class="trust-logo">TypeScript</span>
          <span class="trust-dot" aria-hidden="true">·</span>
          <span class="trust-logo">Tailwind</span>
          <span class="trust-dot" aria-hidden="true">·</span>
          <span class="trust-logo">Astro</span>
          <span class="trust-dot" aria-hidden="true">·</span>
          <span class="trust-logo">PostgreSQL</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem 5rem;
    overflow: hidden;
  }

  .hero-orb-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 700px;
    pointer-events: none;
    z-index: 0;
  }

  /* Gradient orbs */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    z-index: 0;
  }

  .hero-orb--accent {
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, var(--color-glow) 0%, transparent 60%);
    animation: pulse-glow 5s ease-in-out infinite;
    opacity: 0.5;
  }

  .hero-orb--cyan {
    bottom: -10%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(6,182,212,0.08) 0%, transparent 60%);
    animation: pulse-glow 6s ease-in-out infinite 2s;
    opacity: 0.4;
  }
  
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
  }
  
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw + 0.5rem, 5rem);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.06em;
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }
  
  .hero-subtitle {
    font-size: clamp(1rem, 1.5vw + 0.5rem, 1.1875rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 500px;
    margin: 0 auto 2.5rem;
    letter-spacing: -0.02em;
  }
  
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn-hero {
    padding: 0.8125rem 2rem;
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  /* Trust bar — minimal, discreet */
  .trust-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .trust-label {
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }

  .trust-logos {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .trust-logo {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .trust-dot {
    color: var(--color-border);
    font-size: 0.625rem;
    user-select: none;
  }
  
  @media (max-width: 640px) {
    .hero { padding: 5rem 1rem 4rem; min-height: auto; }
    .hero-orb-wrapper { width: 350px; height: 350px; }
    .hero-orb--accent { width: 350px; height: 350px; top: 5%; }
    .hero-orb--cyan { width: 250px; height: 250px; }
    .trust-bar { flex-direction: column; gap: 0.375rem; }
  }
</style>
