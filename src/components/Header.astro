---
// Header component with navigation and theme toggle — Linear-inspired
---

<header class="header" role="banner">
  <nav class="header-inner" aria-label="Navegación principal">
    <a href="/" class="header-logo" aria-label="WalletWise - Inicio">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="url(#logo-grad)" />
        <path d="M10 16.5L14 20.5L22 12.5" stroke="#0f172a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <defs>
          <linearGradient id="logo-grad" x1="0" y1="0" x2="32" y2="32">
            <stop stop-color="#34d399"/>
            <stop offset="1" stop-color="#06b6d4"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="header-logo-text">WalletWise</span>
    </a>

    <!-- Nav links — Linear-style with hover underline -->
    <div class="header-nav">
      <a href="#features" class="nav-link">Características</a>
      <a href="#how-it-works" class="nav-link">Cómo funciona</a>
      <a href="https://github.com/devcodewolf/WalletWise" class="nav-link" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
    
    <div class="header-actions">
      <button 
        type="button"
        class="theme-toggle"
        onclick="window.toggleTheme()"
        aria-label="Cambiar tema"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="2" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      
      <a href="https://wallet-wise.devcodewolf.com" class="btn-header" rel="noopener">
        Abrir WalletWise
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid var(--color-border);
  }
  
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
  }
  
  .header-logo-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.025em;
  }

  /* Nav links */
  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    transition: color 0.15s ease, background 0.15s ease;
    letter-spacing: -0.015em;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 1px;
    left: 0.75rem;
    right: 0.75rem;
    height: 1.5px;
    background: var(--color-text);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }
  
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 0.375rem;
    border: none;
    box-shadow: 0 0 0 1px var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .theme-toggle:hover {
    box-shadow: 0 0 0 1px var(--color-border-hover);
    color: var(--color-text);
    background: var(--color-bg-card);
  }
  
  /* Show/hide icons based on theme */
  html.dark .icon-moon { display: none; }
  html.dark .icon-sun { display: block; }
  html.light .icon-sun { display: none; }
  html.light .icon-moon { display: block; }
  
  .btn-header {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.875rem;
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 0.8125rem;
    border-radius: 0.375rem;
    border: none;
    text-decoration: none;
    transition: all 0.15s ease;
    letter-spacing: -0.01em;
  }
  .btn-header:hover {
    opacity: 0.88;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--color-glow);
  }
  
  @media (max-width: 640px) {
    .header-inner { padding: 0 1rem; }
    .header-logo-text { display: none; }
    .header-nav { display: none; }
    .btn-header span { display: none; }
    .btn-header::after { content: 'Abrir'; }
  }
</style>
