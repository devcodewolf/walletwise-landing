---
// Footer component — Linear-inspired minimal
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="WalletWise - Inicio">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="url(#flogo-grad)" />
            <path d="M10 16.5L14 20.5L22 12.5" stroke="#0f172a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <defs>
              <linearGradient id="flogo-grad" x1="0" y1="0" x2="32" y2="32">
                <stop stop-color="#34d399"/>
                <stop offset="1" stop-color="#06b6d4"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="footer-logo-text">WalletWise</span>
        </a>
        <p class="footer-desc">
          Gestor de finanzas personales gratuito. Diseñado para ayudarte a tomar el control de tu dinero con claridad y sin estrés.
        </p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4 class="footer-col-title">Producto</h4>
          <a href="https://wallet-wise.devcodewolf.com" class="footer-link" rel="noopener">Abrir la app</a>
          <a href="#features" class="footer-link">Características</a>
          <a href="#how-it-works" class="footer-link">Cómo funciona</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Recursos</h4>
          <a href="https://github.com/devcodewolf/WalletWise" class="footer-link" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right:0.375rem;flex-shrink:0;">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a href="https://github.com/devcodewolf/walletwise-landing" class="footer-link" target="_blank" rel="noopener noreferrer">Landing page repo</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; 2026 WalletWise. Creado con precisión.</p>
      <div class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-text">Activo</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 4rem 1.5rem 2rem;
    box-shadow: 0 -1px 0 var(--color-border);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    max-width: 300px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    margin-bottom: 0.625rem;
  }

  .footer-logo-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
  }

  .footer-desc {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    letter-spacing: -0.005em;
  }

  .footer-links {
    display: flex;
    gap: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .footer-col-title {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.25rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 0.125rem 0;
    letter-spacing: -0.01em;
  }

  .footer-link:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.25rem;
    box-shadow: 0 -1px 0 var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-copy {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .footer-status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .status-text {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .footer {
      padding: 3rem 1rem 1.5rem;
    }
    .footer-inner {
      flex-direction: column;
      gap: 2rem;
    }
    .footer-links {
      gap: 2.5rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>
